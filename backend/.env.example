# Copy to .env and fill in real values. `.env` is git-ignored on purpose.
# `init.ps1` creates .env for you and generates SECRET_KEY.

APP_NAME=enterprise-admin
APP_VERSION=0.1.0
DEBUG=true
DOCS_ENABLED=true
API_V1_PREFIX=/api/v1

# Required, no default. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=enterprise_admin

# Comma-separated (not JSON).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
